# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================

# ----- AUTHENTICATION -----
# In Vocareum workspace: ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL
# are already set in your environment. Do NOT add them here.
#
# For local development with your own API key:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# A Vocareum key (voc-...) used outside the workspace also needs the Vocareum proxy URL:
# ANTHROPIC_API_KEY=voc-your-key-here
# ANTHROPIC_BASE_URL=https://claude.vocareum.com
#
# For AWS Bedrock (used instead of ANTHROPIC_API_KEY when both AWS keys are set):
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1
# Only for temporary credentials:
# AWS_SESSION_TOKEN=your-session-token
# CLAUDE_CODE_USE_BEDROCK=1 is set automatically when the AWS keys are found.

# ----- MODEL CONFIGURATION (REQUIRED) -----
# Used by the orchestrator and all subagents.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# With AWS Bedrock, use a Bedrock model ID instead, for example:
# ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ----- PROJECT ROOT (OPTIONAL) -----
# Absolute path to the project/starter directory
# If set, it must be the folder that contains .claude/skills/.
# If unset, the current directory is used.

# Vocareum workspace:
PROJECT_ROOT=/voc/work/cd14715-claude-code-classroom/project/starter

# Local development (update to your path, or delete the line above):
# PROJECT_ROOT=/absolute/path/to/project/starter

# ----- GITHUB TOKEN (RECOMMENDED) -----
# For higher rate limits and private repository access.
# Without a token GitHub allows 60 requests an hour and code search fails.
# Generate at: https://github.com/settings/tokens
# The 'repo' scope is only needed for private repositories.
# GITHUB_TOKEN=ghp_your-token-here

# ----- LOGGING (OPTIONAL) -----
# Options: error, warn, info, debug (debug also logs each subagent as it starts)
LOG_LEVEL=info

# NODE_ENV=production turns off console logging. logs/ is still written.
# NODE_ENV=production
